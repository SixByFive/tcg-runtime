{
  "name": "sixbyfive-tcg-services",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:core": "pnpm --parallel --filter @sbf/gateway --filter @sbf/auth-service --filter @sbf/user-service --filter @sbf/catalog-service dev",
    "dev:gateway": "pnpm --filter @sbf/gateway dev",
    "dev:all": "pnpm --parallel --filter @sbf/gateway --filter @sbf/auth-service --filter @sbf/catalog-service --filter @sbf/collections-service --filter @sbf/marketplace-service --filter @sbf/trading-service --filter @sbf/notifications-service --filter @sbf/media-service --filter @sbf/realtime-service --filter @sbf/payments-service --filter @sbf/worker-service dev",
    "health": "node infra/scripts/health-all.mjs",
    "health:core": "node infra/scripts/health-all.mjs --only=gateway,auth-service,catalog-service --strict",
    "health:strict": "node infra/scripts/health-all.mjs --strict",
    "schema:export": "pnpm --filter @sbf/gateway schema:export",
    "codegen": "pnpm --filter @sbf/api-types codegen",
    "build:packages": "pnpm --filter @sbf/api-types build && pnpm --filter @sbf/api-client build"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "mysql2": "^3.20.0",
    "sequelize": "^6.37.8"
  }
}